# Copy to .env.local for local development. Never commit .env.local.
# In containers, set these as environment variables instead.

# Better Auth: a random secret of at least 32 characters, and the site's public URL.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SQLite database file. Keep it under data/, which git ignores.
DATABASE_PATH=data/crib.db
# Where the migrations live (the default suits local development).
MIGRATIONS_DIR=server/db/migrations

# Lets `npm run seed` import puzzles through the running server. At least 16 characters.
ADMIN_TOKEN=
# The server `npm run seed` talks to.
CRIB_URL=http://localhost:3000

{
  "name": "crib",
  "version": "0.1.0",
  "private": true,
  "description": "Crib: a daily cipher-deduction word game",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "generate": "tsx scripts/generate.ts",
    "seed": "tsx scripts/seed.ts",
    "db:migration": "drizzle-kit generate",
    "auth:schema": "npx -y auth@1.7.10 generate --config server/auth/schema.config.ts --adapter drizzle --dialect sqlite --output server/db/auth-schema.ts --yes",
    "playtest:build": "tsx scripts/build-playtest.ts",
    "test:e2e:playtest": "playwright test --config playwright.playtest.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
